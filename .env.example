# Copy to .env and adjust. docker-compose.yml reads these; the Kubernetes
# manifests define the same values in k8s/01-configmap.yaml and
# k8s/02-secret.yaml. DEMO VALUES ONLY.

POSTGRES_DB=iep_auth
POSTGRES_USER=iep
POSTGRES_PASSWORD=iep

MONGO_DB=iep_fund

JWT_SECRET_KEY=super-secret-key-change-in-production

# true = /decision deploys an on-chain voting contract (needs `ganache`);
# false = immediate {uuid, approved} decisions.
BLOCKCHAIN_ENABLED=true
